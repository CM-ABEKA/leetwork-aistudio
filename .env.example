# AI Model Studio Platform - Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# GENERAL
# ============================================
NODE_ENV=development
ENVIRONMENT=development

# ============================================
# DATABASE (PostgreSQL)
# ============================================
POSTGRES_USER=mlplatform
POSTGRES_PASSWORD=mlplatform_dev_pass
POSTGRES_DB=mlplatform
POSTGRES_PORT=5432

# Database URL for application use
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================================
# REDIS (Cache & Queue)
# ============================================
REDIS_PASSWORD=redis_dev_pass
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ============================================
# MINIO (Object Storage)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=ml-platform
MINIO_SECURE=false

# MinIO endpoint (internal for services)
MINIO_ENDPOINT=minio:9000
# MinIO access credentials
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# ============================================
# FRONTEND (Next.js)
# ============================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_WS_URL=ws://localhost:8002

# ============================================
# BACKEND SERVICES
# ============================================

# Auth Service
AUTH_SERVICE_PORT=8001
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orchestrator Service
ORCHESTRATOR_PORT=8002
AUTH_SERVICE_URL=http://auth-service:8001

# ML Classical Service
ML_CLASSICAL_PORT=8010

# ML NLP Service
ML_NLP_PORT=8011

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# MONITORING (Optional)
# ============================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
GRAFANA_ROOT_URL=http://localhost:3001

# ============================================
# CELERY WORKERS
# ============================================
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# SECURITY
# ============================================
# Add your security configurations here
# SECRET_KEY=
# API_KEY=

# ============================================
# NOTES
# ============================================
# - In production, use strong, unique passwords
# - Never commit the .env file to version control
# - Keep JWT_SECRET at least 32 characters long
# - Enable MINIO_SECURE=true in production
# - Use proper SSL certificates in production
